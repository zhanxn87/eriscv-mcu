if SOC_ERISCV_MCU

config SOC
	default "eriscv_mcu"

config NUM_IRQS
	int
	default 32

config SYS_CLOCK_HW_CYCLES_PER_SEC
	int
	default 100000000

config RISCV_ISA_EXT_M
	bool
	default n

config RISCV_ISA_EXT_C
	bool
	default y

endif # SOC_ERISCV_MCU
